generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                 @id @default(uuid())
  email            String                 @unique
  passwordHash     String                 @map("password_hash")
  role             Role
  firstName        String                 @map("first_name")
  lastName         String                 @map("last_name")
  phone            String?
  birthDate        DateTime?              @map("birth_date")
  birthPlace       String?                @map("birth_place")
  nationality      String?
  address          String?
  zipCode          String?                @map("zip_code")
  city             String?
  avatarUrl        String?                @map("avatar_url")
  signatureBase64  String?                @map("signature_base64")
  isVerified       Boolean                @default(false) @map("is_verified")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  country          String?                @default("France")
  gender           Gender?
  documents        Document[]
  transactions     FinancialTransaction[]
  hthProfile       HthProfile?
  juniorProfile    JuniorProfile?
  volunteerMatches MonthlyFollowup[]      @relation("VolunteerFollowups")
  seniorProfile    SeniorProfile?
}

model SeniorProfile {
  id                 String           @id @default(uuid())
  userId             String           @unique @map("user_id")
  housingType        String           @map("housing_type")
  roomSurface        Float            @map("room_surface")
  hasPets            Boolean          @default(false) @map("has_pets")
  accessibilityLevel String           @map("accessibility_level")
  isProfileComplete  Boolean          @default(false) @map("is_profile_complete")
  sleepHabit         SleepHabit?      @map("sleep_habit")
  presencePattern    PresencePattern? @map("presence_pattern")
  socialNeed         SocialNeed?      @map("social_need")
  noiseTolerance     NoiseTolerance?  @map("noise_tolerance")
  guestTolerance     GuestTolerance?  @map("guest_tolerance")
  smokerTolerance    SmokerTolerance? @map("smoker_tolerance")
  requiredServices   ServiceType[]    @map("required_services")
  hobbies            String[]
  housingPhotos      String[]         @map("housing_photos")
  discoverySource    String?          @map("discovery_source")
  duration           String?
  freeComments       String?          @map("free_comments")
  motivations        String?
  mutualInsurance    String?          @map("mutual_insurance")
  targetDepartments  String[]         @map("target_departments")
  matches            Match[]          @relation("SeniorMatches")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JuniorProfile {
  id                String           @id @default(uuid())
  userId            String           @unique @map("user_id")
  situation         String
  targetCities      String[]         @map("target_cities")
  maxBudget         Float            @map("max_budget")
  moveInDate        DateTime         @map("move_in_date")
  isProfileComplete Boolean          @default(false) @map("is_profile_complete")
  hasPets           Boolean          @default(false) @map("has_pets")
  isSmoker          Boolean          @default(false) @map("is_smoker")
  hasCar            Boolean          @default(false) @map("has_car")
  sleepHabit        SleepHabit?      @map("sleep_habit")
  presencePattern   PresencePattern? @map("presence_pattern")
  socialNeed        SocialNeed?      @map("social_need")
  noiseTolerance    NoiseTolerance?  @map("noise_tolerance")
  guestTolerance    GuestTolerance?  @map("guest_tolerance")
  offeredServices   ServiceType[]    @map("offered_services")
  hobbies           String[]
  idCardUrl         String?          @map("id_card_url")
  statusProofUrl    String?          @map("status_proof_url")
  discoverySource   String?          @map("discovery_source")
  duration          String?
  freeComments      String?          @map("free_comments")
  motivations       String?
  mutualInsurance   String?          @map("mutual_insurance")
  targetDepartments String[]         @map("target_departments")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches           Match[]          @relation("JuniorMatches")
}

model HthProfile {
  id                       String @id @default(uuid())
  userId                   String @unique @map("user_id")
  civicServiceOrganization String @map("civic_service_organization")
  missionDuration          Int    @map("mission_duration")
  missionDates             String @map("mission_dates")
  user                     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Match {
  id                      String                  @id @default(uuid())
  seniorId                String                  @map("senior_id")
  juniorId                String                  @map("junior_id")
  status                  MatchStatus             @default(SUGGESTED)
  score                   Float?
  housingFormula          HousingFormula          @map("housing_formula")
  financialManagementType FinancialManagementType @default(COAB_MANAGED) @map("financial_management_type")
  contractType            String?                 @map("contract_type")
  paidServices            String[]                @map("paid_services")
  rentAmount              Float?                  @map("rent_amount")
  chargesAmount           Float?                  @map("charges_amount")
  startDate               DateTime?               @map("start_date")
  endDate                 DateTime?               @map("end_date")
  documents               Document[]
  transactions            FinancialTransaction[]
  junior                  JuniorProfile           @relation("JuniorMatches", fields: [juniorId], references: [id])
  senior                  SeniorProfile           @relation("SeniorMatches", fields: [seniorId], references: [id])
  followups               MonthlyFollowup[]
  rentReceipts            RentReceipt[]
}

model MonthlyFollowup {
  id                 String   @id @default(uuid())
  matchId            String   @map("match_id")
  volunteerId        String   @map("volunteer_id")
  interviewDate      DateTime @map("interview_date")
  seniorFeedback     String?  @map("senior_feedback")
  juniorFeedback     String?  @map("junior_feedback")
  generalNotes       String?  @map("general_notes")
  
  // Nouveaux champs pour le suivi détaillé (Statistiques)
  qualityRating      Int?     @map("quality_rating") // Note de 1 à 5
  incidentsReported  Boolean  @default(false) @map("incidents_reported")
  incidentDetails    String?  @map("incident_details")
  nextActionSteps    String?  @map("next_action_steps")
  
  sentToStakeholders Boolean  @default(false) @map("sent_to_stakeholders")
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  volunteer          User     @relation("VolunteerFollowups", fields: [volunteerId], references: [id])
}

model Document {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  matchId           String?      @map("match_id")
  docType           DocumentType @map("doc_type")
  fileUrl           String       @map("file_url")
  fileData          String?      @map("file_data") // Pour stocker en Base64 dans Neon
  signedAt          DateTime?    @map("signed_at")
  signatureMetadata Json?        @map("signature_metadata")
  match             Match?       @relation(fields: [matchId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinancialTransaction {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  matchId         String?           @map("match_id")
  type            TransactionType
  amount          Float
  paymentProvider PaymentProvider   @map("payment_provider")
  status          TransactionStatus @default(PENDING)
  paidAt          DateTime?         @map("paid_at")
  match           Match?            @relation(fields: [matchId], references: [id])
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RentReceipt {
  id        String   @id @default(uuid())
  matchId   String   @map("match_id")
  period    String
  amount    Float
  paidAt    DateTime @map("paid_at")
  fileUrl   String?  @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model AssociationIncome {
  id          String         @id @default(uuid())
  category    IncomeCategory
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
}

model AssociationExpense {
  id          String          @id @default(uuid())
  category    ExpenseCategory
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
}

enum Role {
  ADMIN
  VOLUNTEER
  SENIOR
  JUNIOR
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
  OTHER
}

enum HousingFormula {
  SOLIDAIRE
  CONVIVIALE
  HTH
}

enum MatchStatus {
  SUGGESTED
  MEETING_SCHEDULED
  TRIAL_PERIOD
  ACTIVE
  ENDED
  CANCELLED
}

enum DocumentType {
  CONTRACT
  CHARTER
  RENT_RECEIPT
  ID_PROOF
}

enum TransactionType {
  MEMBERSHIP_COHABILIS
  COAB_DUES
  RENT_PAYMENT
  GRANT
}

enum PaymentProvider {
  STRIPE
  HELLOASSO
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum FinancialManagementType {
  COAB_MANAGED
  SELF_MANAGED
}

enum IncomeCategory {
  SUBVENTION
  DONATION
  MEMBERSHIP
  SERVICE_FEE
  OTHER
}

enum ExpenseCategory {
  SALARY
  RENT
  SOFTWARE
  MARKETING
  TRAVEL
  OTHER
}

enum SleepHabit {
  EARLY_BIRD
  LATE_SLEEPER
  VARIABLE
}

enum PresencePattern {
  HIGH
  MEDIUM
  LOW
}

enum SocialNeed {
  INDEPENDENT
  BALANCED
  HIGHLY_SOCIAL
}

enum NoiseTolerance {
  LOW
  MEDIUM
  HIGH
}

enum GuestTolerance {
  NEVER
  OCCASIONALLY
  FREQUENTLY
}

enum SmokerTolerance {
  STRICTLY_NO
  OUTSIDE_ONLY
  YES
}

enum ServiceType {
  NIGHT_PRESENCE
  GROCERY_HELP
  IT_HELP
  GARDENING
  PET_WALKING
  COMPANY
  HOMEWORK_HELP
}
